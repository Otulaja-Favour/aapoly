# AfriBase project credentials — copy this file to ".env" and fill in your values.
# Find them in your AfriBase dashboard under: Settings > API
VITE_AFRIBASE_URL=https://your-project.afribase.dev
VITE_AFRIBASE_ANON_KEY=your-anon-key

# Passcode that unlocks the admin area (/admin/login). Pick anything you like.
VITE_ADMIN_PASSCODE=change-me
