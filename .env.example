# AfriBase project credentials — copy this file to ".env" and fill in your values.
# Find them in your AfriBase dashboard under: Settings > API
VITE_AFRIBASE_URL=https://your-project.afribase.dev
VITE_AFRIBASE_ANON_KEY=your-anon-key

# Passcode that unlocks the admin area (/admin/login). Pick anything you like.
VITE_ADMIN_PASSCODE=change-me

# Paystack PUBLIC key — safe to ship to the browser. Use pk_test_... while testing.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only values. These belong in your host's environment settings (Vercel →
# Settings → Environment Variables), NEVER in this file or in the built bundle.
#   PAYSTACK_SECRET_KEY   sk_test_... / sk_live_...  (used by /api/verify-payment)
#   AFRIBASE_URL          only needed if the VITE_ names aren't visible to the function
#   AFRIBASE_ANON_KEY     ditto
